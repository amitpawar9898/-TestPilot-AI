# OPTIONAL and for server administrators only. The app has no place to type keys; leave this empty to use the built-in engine
# (or a local Ollama, which is detected automatically).
# Copy to .env and fill in only what you need. Never commit .env.
# Choose a provider in Settings, or configure it below for unattended server startup.
# OpenAI API keys support GPT and Codex API models; ChatGPT Plus/Pro login is separate from API billing.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Groq, OpenRouter, Together, LM Studio, vLLM...)
OPENAI_COMPATIBLE_API_KEY=

# Ollama needs no key; make sure `ollama serve` is running.

# Opt-in ONLY for your own trusted code when Docker is not available.
# This is NOT a sandbox. Leave unset to keep untrusted-code execution disabled.
# TESTPILOT_ALLOW_UNSAFE_LOCAL=1

# Optional server configuration:
# TESTPILOT_REQUIRE_LOGIN=1
# TESTPILOT_DATA_DIR=C:/testpilot-data
# TESTPILOT_REPORTS_DIR=C:/testpilot-reports

# Optional LLM configuration (environment values override Settings):
# TESTPILOT_PROVIDER=openai
# TESTPILOT_MODEL=gpt-5.3-codex
# TESTPILOT_LLM_CONSENT=1  # explicitly permits sending submitted source to the selected cloud provider

# Free, private local Ollama option (requires Ollama installed and model pulled):
# TESTPILOT_PROVIDER=ollama
# TESTPILOT_MODEL=qwen2.5-coder:1.5b
# TESTPILOT_BASE_URL=http://127.0.0.1:11434/v1
